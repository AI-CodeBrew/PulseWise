# Copy this file to ".env" and fill in the values.
# .env is git-ignored, so your secrets never get committed.

# ======================================================================
# 1. DATABASE (Supabase Postgres)  -- required
# ======================================================================
# Supabase dashboard > your project > "Connect" > "Session pooler" > copy the URI,
# then replace [YOUR-PASSWORD] with your DATABASE password (Project Settings > Database).
#
# Use the SESSION POOLER string (host looks like aws-0-<region>.pooler.supabase.com,
# user is postgres.<project-ref>). The "Direct connection" string only works on networks
# with IPv6, which many home/office internet connections don't have.
# If your password has special characters (@ : / # ? %), URL-encode them (@ becomes %40).
DATABASE_URL=

# ======================================================================
# 2. SECURITY KEYS  -- required (python -m app.cli generate-keys makes new ones)
# ======================================================================
# Signs login sessions. Changing it logs everyone out.
JWT_SECRET=
# Encrypts the PostHog API keys stored in the database.
# BACK THIS UP (password manager): without it the stored keys can't be read again.
# To rotate: put the NEW key first, keep the old one after a comma: new,old
ENCRYPTION_KEY=

# ======================================================================
# 3. PostHog -- only used ONCE, by `python -m app.cli bootstrap`
# ======================================================================
# After bootstrap, the connection (with the key encrypted) lives in the database,
# and you can delete the key from this file. Each client's website gets its own.
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# ======================================================================
# 4. Optional (the defaults are fine for local development)
# ======================================================================
# Where the dashboard runs. Used for password-reset links and allowed browser origins.
FRONTEND_URL=http://localhost:3000
# More allowed browser origins, comma separated (default: FRONTEND_URL).
# CORS_ORIGINS=http://localhost:3000
# Login lasts this many days.
# SESSION_DAYS=7
# The admin panel asks for the password again; it then stays open this many minutes (renewed while it is used).
# ADMIN_UNLOCK_MINUTES=30
# Cookies only over HTTPS. Default: on when FRONTEND_URL starts with https://.
# COOKIE_SECURE=true
# How long PostHog results are cached, in seconds (the live feed has its own short cache).
# CACHE_TTL_SECONDS=300
# LIVE_CACHE_TTL_SECONDS=10

# Password-reset emails. Without SMTP_HOST the email is printed in the backend console
# instead of being sent (fine for development: copy the link from there).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Iris <no-reply@yourdomain.com>

# Weekly report summaries written by AI (Claude). Optional: without a key (or with the switch off in
# Admin -> Settings) the reports use fixed, rule-based sentences instead. Only aggregated numbers are sent.
# ANTHROPIC_API_KEY=

# Weekly reports on WhatsApp (Meta WhatsApp Business Cloud API). Optional. Needs an approved message template:
# see docs/ROADMAP.md, Phase 10. Without these, the WhatsApp fields stay hidden from clients.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
