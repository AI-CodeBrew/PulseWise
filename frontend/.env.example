# Copy to ".env.local" to change these (optional; the defaults work locally).
# NEXT_PUBLIC_* values are visible in the browser, so NEVER put secrets here.
# The PostHog API key belongs in backend/.env only.

# Where the FastAPI backend runs (local development: the browser calls it directly).
NEXT_PUBLIC_API_URL=http://localhost:8000

# PRODUCTION on Vercel (works without a custom domain, because the login cookie then belongs to your Vercel site):
#   NEXT_PUBLIC_API_URL=/
#   BACKEND_URL=https://your-backend.onrender.com     (server-side only; Next forwards /api/* there)
# and in the backend set FRONTEND_URL=https://your-site.vercel.app

# Product name shown in the sidebar and browser tab (white-label).
NEXT_PUBLIC_BRAND_NAME=PulseWise
